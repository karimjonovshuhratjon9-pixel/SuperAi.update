# ============================================
# SUPERAI 2.0 — Environment Configuration
# ============================================

# ================= AI PROVIDERS =================

# Google Gemini API Key (Core AI Model & Embeddings)
# Bepul kalit olish: https://aistudio.google.com/app/apikey
# Diqqat: kalit "AIzaSy..." bilan boshlanishi kerak!
VITE_API_KEY=

# Anthropic Claude API Key (Fallback & Coding Model)
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ================= VOICE & AUDIO =================

# ElevenLabs Natural Voice API Key (Ultra-realistic AI voice synthesis)
# Bepul kalit olish: https://elevenlabs.io
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ================= VIDEO & AVATARS =================

# HeyGen AI Video & Avatar API Key (Photorealistic AI talking avatars & video generation)
# Kalit olish: https://app.heygen.com/home?from=&nav=API
VITE_HEYGEN_API_KEY=
HEYGEN_API_KEY=

# ================= SEARCH =================

# Tavily AI Web Search API Key (Real-time grounding & Deep Research)
# Bepul olish: https://tavily.com
VITE_TAVILY_API_KEY=

# ================= INTEGRATIONS =================

# Telegram Bot Integration (Agent Tools)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# ================= IMAGE GENERATION =================

# Pollinations AI (Free image generation - no key needed)
# Optional: Use a custom image generation API if needed
VITE_IMAGE_API_KEY=

# ================= MUSIC GENERATION =================

# Optional: Music generation API key (e.g., Suno, Udio)
VITE_MUSIC_API_KEY=

# ================= DATABASE (Future Backend) =================

# For future backend deployment (currently uses IndexedDB in browser)
DATABASE_URL=

# ================= SECURITY =================

# Auth secret for session management (future backend)
AUTH_SECRET=

# ================= MONITORING =================

# Optional: Sentry or similar error tracking
VITE_SENTRY_DSN=